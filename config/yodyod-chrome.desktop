[Desktop Entry]
Version=1.0
Type=Application
Name=Web Browser
Name[zh_CN]=网页浏览器
Comment=Open the shared YodYod Chrome browser
Exec=/usr/local/bin/yodyod-browser %U
Icon=google-chrome
Terminal=false
Categories=Network;WebBrowser;
MimeType=text/html;application/xhtml+xml;x-scheme-handler/http;x-scheme-handler/https;
StartupNotify=true
